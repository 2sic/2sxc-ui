{
  "extends": "../inpage/tsconfig.json",
  "compilerOptions": {
    // "outDir": "../../sxc-typings/dist",
    "declaration": true,
    "removeComments": false,
    "emitDeclarationOnly": true,

    // "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    // "target": "ES2020",
    "module": "commonjs", // or "ESNext"

    // Prevent auto-loading all @types in node_modules
    // "types": []
  },
  "include": [
    "../inpage/src/**/*.ts",

    "../$2sxc/src/*.ts",
    "../$2sxc/src/*.js", 
    "../$2sxc/src/**/*.ts",
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/*.spec.d.ts",
    "**/*.test.ts",
    "**/*.test.d.ts",
    "**/tests/**",
    "**/__tests__/**",
    "**/vitest/**",
    "**/vitest.config.js",
  ]
}

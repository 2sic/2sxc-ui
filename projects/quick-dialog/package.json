{
  "name": "2sxc-quick-dialog",
  "//version-notes": "FYI: This version isn't used for the build.",
  "version": "12.01.00",
  "license": "MIT",
  "scripts": {
    "dev-angular": "ng serve --configuration development",
    "dev-dist": "npm run dev-prepare && npm run distribute",
    "dev": "npm run dev-prepare && concurrently --kill-others-on-fail --names angular,deploy npm:dev-build npm:deploy-watch",
    "release": "npm run build:production && npm run postbuild:i18n && npm run postbuild:sourcemap && npm run distribute",
    "build:development": "ng build --configuration development",
    "build:production": "ng build --configuration production",
    "postbuild:i18n": "node copy-i18n.js",
    "postbuild:sourcemap": "node correct-sourcemap-urls.mjs",
    "dev-build": "ng build --configuration development --watch",
    "distribute": "node ../webpack/distribute2.js ./dist/quick-dialog/browser dist/quick-dialog/",
    "deploy-watch": "node ../webpack/distribute2.js ./dist/quick-dialog/browser dist/quick-dialog/ -w",
    "dev-prepare": "npm run build:development && npm run postbuild:i18n"
  },
  "private": true,
  "dependencies": {
    "@2sic.com/2sxc-typings": "^14.7.3",
    "@2sic.com/sxc-angular": "^18.0.0",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "rxjs": "^7.8.2",
    "sass": "^1.102.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@types/jasmine": "3.5.7",
    "@types/node": "^22.13.10",
    "chalk": "^4.1.0",
    "concurrently": "^10.0.5",
    "typescript": "^6.0.3"
  }
}
